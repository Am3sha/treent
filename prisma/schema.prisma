// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Corporate site capture ----

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  topic     String   @default("general") // general | services | partnership | press
  message   String
  status    String   @default("new") // new | contacted | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
  @@index([status])
}

model CareerApplication {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  roleSlug  String
  roleTitle String
  yearsExp  Int?
  linkedin  String?
  portfolio String?
  resume    String? // stored as text (filename / data url reference)
  message   String?
  status    String   @default("new") // new | screening | interview | offer | rejected | hired
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([createdAt])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("footer")
  createdAt DateTime @default(now())
}

// ---- Benchmark / Assessment capture ----

model Assessment {
  id               String   @id @default(cuid())
  // Respondent profile (captured at end of questionnaire)
  respondentName   String?
  respondentEmail  String?
  companyName      String?
  companySize      String? // 1-10 | 11-50 | 51-200 | 201-1000 | 1000+
  industry         String?
  country          String?
  role             String?
  consentContact   Boolean  @default(false)
  // Scoring (0-100 per domain + overall), overall = earned/78*100
  overallScore     Float
  governanceScore  Float
  riskScore        Float
  executionScore   Float
  reportingScore   Float
  capabilityScore  Float
  // Anonymous maturity tier (initial | developing | defined | established | advanced)
  tier             String
  // Number of questions answered
  questionCount    Int
  durationSec      Int?
  createdAt        DateTime @default(now())
  answers          AssessmentAnswer[]
  followUps        AssessmentFollowUp[]
  @@index([createdAt])
  @@index([tier])
  @@index([industry])
  @@index([companySize])
  @@index([country])
  @@index([overallScore])
}

model AssessmentAnswer {
  id             String   @id @default(cuid())
  assessment     Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId   String
  questionId     String
  domain         String
  selectedOption String
  score          Int
  createdAt      DateTime @default(now())
  @@index([assessmentId])
  @@index([questionId])
  @@index([domain])
}

model AssessmentFollowUp {
  id           String   @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  name         String
  email        String
  company      String?
  phone        String?
  message      String?
  // What the respondent is interested in
  interest     String   @default("consultation") // consultation | report | workshop | partnership
  status       String   @default("new")
  createdAt    DateTime @default(now())
  @@index([status])
  @@index([createdAt])
}
