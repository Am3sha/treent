DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-cryptographically-random-string

ADMIN_EMAIL=admin@example.com
# IMPORTANT: Use backslash-escaped $ signs in the hash, e.g.:
# ADMIN_PASSWORD_HASH=\$2b\$12\$(your-bcrypt-hash)
# Unescaped $ signs are stripped by Next.js's env loader.
ADMIN_PASSWORD_HASH=replace-with-backslash-escaped-bcrypt-hash

# Allowed origins for public form submissions (contact, newsletter, careers, benchmark, follow-up)
# Comma-separated list of origins (protocol + domain, no path). Example: https://trennt.sa,https://www.trennt.sa
# REQUIRED for production deployment — must be set on your hosting platform (Vercel, Render, Railway, etc.)
# to match the actual production domain(s) serving traffic. Include both www and non-www if both are used.
ALLOWED_FORM_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
