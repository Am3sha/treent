DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-cryptographically-random-string

ADMIN_EMAIL=admin@example.com
# IMPORTANT: Use backslash-escaped $ signs in the hash, e.g.:
# ADMIN_PASSWORD_HASH=\$2b\$12\$(your-bcrypt-hash)
# Unescaped $ signs are stripped by Next.js's env loader.
ADMIN_PASSWORD_HASH=replace-with-backslash-escaped-bcrypt-hash

# Allowed origins for public form submissions (contact, newsletter, careers, benchmark, follow-up)
# Comma-separated list of origins (protocol + domain, no path). Example: https://trennt.sa,https://www.trennt.sa
# REQUIRED for production deployment — must be set on your hosting platform (Vercel, Render, Railway, etc.)
# to match the actual production domain(s) serving traffic. Include both www and non-www if both are used.
ALLOWED_FORM_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Upstash Redis for distributed rate limiting (public form endpoints + admin login).
# On Vercel, provision the "Upstash Redis" integration and it injects these automatically.
# Without them, rate limiting falls back to PER-INSTANCE in-memory counters (works in
# local dev; NOT reliable across serverless instances). Set these before launch.
REDIS_URL=
REDIS_TOKEN=
# Alternative names accepted: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN

# Vercel Blob for storing uploaded CV/résumé files (object storage instead of Postgres).
# On Vercel, provision the "Blob" store; it injects BLOB_READ_WRITE_TOKEN. Without it,
# uploads cannot be stored (the careers endpoint rejects them rather than writing base64
# into Postgres) - set this before enabling public CV uploads.
BLOB_READ_WRITE_TOKEN=
